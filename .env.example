# Discover Kashmir — website
#
# Copy to .env.local for development. In production set these in your host's
# environment settings (Vercel: Project → Settings → Environment Variables).

# The content & payments API. Used both server-side during page generation and
# in the browser by the admin.
NEXT_PUBLIC_API_URL="https://api.thediscoverkashmir.in/api/v1"

# Where this site is reachable. Vercel infers it, but setting it explicitly
# avoids admin sign-in redirecting to a preview URL.
NEXTAUTH_URL="https://thediscoverkashmir.in"

# Signs the admin session cookie. Changing it signs everyone out.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=""

# Must match REVALIDATE_SECRET in the API's environment. Without it, content
# edits still save but the live pages wait for the next scheduled rebuild.
REVALIDATE_SECRET=""

# Optional — only if the site is served from a different domain than the
# sitemap should advertise. Defaults to https://thediscoverkashmir.in
# NEXT_PUBLIC_SITE_URL=""
